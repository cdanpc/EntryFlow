DATABASE_URL="postgresql://postgres:password@localhost:5432/entryflow?schema=public"
# For Supabase on Vercel, use the transaction pooler (:6543) with
# ?pgbouncer=true&connection_limit=1 for application traffic.
# Runtime also adapts legacy Supabase session-pooler (:5432) URLs;
# Prisma CLI/migrations keep the original DATABASE_URL unchanged.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
# Optional canonical HTTPS origin for ticket QR links (recommended for a custom domain).
APP_URL=""
DEMO_ORGANIZER_PASSWORD="set-a-demo-organizer-password"
DEMO_DOOR_STAFF_PASSWORD="set-a-demo-door-staff-password"
