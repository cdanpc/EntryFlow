generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum RegistrationStatus {
  CONFIRMED
  CHECKED_IN
  WAITLISTED
  CANCELLED
}

enum StaffRole {
  ORGANIZER
  DOOR_STAFF
}

model Event {
  id            String         @id @default(cuid())
  title         String
  description   String         @db.Text
  venue         String
  startsAt      DateTime       @db.Timestamptz(3)
  endsAt        DateTime       @db.Timestamptz(3)
  capacity      Int
  status        EventStatus    @default(DRAFT)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  registrations Registration[]

  @@index([status, startsAt])
  @@map("events")
}

model Registration {
  id           String             @id @default(cuid())
  eventId      String             @map("event_id")
  fullName     String             @map("full_name")
  email        String
  normalizedEmail String           @map("normalized_email")
  mobile       String
  ticketCode   String             @unique @map("ticket_code")
  manualCode   String             @unique @map("manual_code") @db.VarChar(6)
  status       RegistrationStatus @default(CONFIRMED)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  checkedInAt  DateTime?          @map("checked_in_at") @db.Timestamptz(3)
  checkedInBy  String?            @map("checked_in_by")
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  staff        StaffUser?         @relation(fields: [checkedInBy], references: [id], onDelete: SetNull)

  @@index([eventId, status, registeredAt])
  @@index([eventId, normalizedEmail, status])
  @@index([fullName])
  @@map("registrations")
}

model StaffUser {
  id            String         @id @default(cuid())
  name          String
  username      String         @unique
  passwordHash  String         @map("password_hash")
  role          StaffRole     @default(ORGANIZER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  checkIns      Registration[]

  @@map("staff_users")
}

model RateLimitBucket {
  key             String   @id
  attempts        Int
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
